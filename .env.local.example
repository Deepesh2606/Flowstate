# Copy this file to .env.local and fill in your values

# Firebase — Auth + Firestore only (no Storage needed)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudinary — for wallpaper uploads (free tier is plenty)
# 1. Sign up at cloudinary.com
# 2. Go to Settings → Upload Presets → Add upload preset
# 3. Set "Signing Mode" = Unsigned → save → copy the preset name
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Gemini AI — for the Flowstate AI Chat sidebar
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Create a free API key and paste it below
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Buy Me a Coffee — for donations / tip jar
# Paste your Buy Me a Coffee or Ko-fi page URL
VITE_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/yourusername
